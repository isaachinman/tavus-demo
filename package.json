{
  "name": "tavus-demo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "build": "bun run build:server && bun run build:client && bun run build:setup",
    "build:client": "esbuild src/client/index.ts --bundle --platform=browser --target=es2022 --format=esm --outfile=public/client.js --sourcemap --log-level=warning",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/server.mjs --sourcemap --log-level=warning",
    "dev": "bun run build && (bun run build:server -- --watch=forever & bun run build:client -- --watch=forever & node --env-file-if-exists=.env --enable-source-maps --watch dist/server.mjs)",
    "lint": "biome check . --error-on-warnings",
    "build:setup": "esbuild scripts/setup.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/setup.mjs --log-level=warning",
    "setup": "bun run build:setup && node --env-file-if-exists=.env --enable-source-maps dist/setup.mjs",
    "start": "bun run build && node --env-file-if-exists=.env --enable-source-maps dist/server.mjs",
    "typecheck": "tsc -noEmit"
  },
  "dependencies": {
    "@daily-co/daily-js": "0.93.0",
    "@hono/node-server": "2.1.5",
    "@logtape/logtape": "2.4.1",
    "agentmail": "0.5.46",
    "hono": "4.13.13",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "ultracite": "6.0.1"
  }
}
