{
  "compilerOptions": {
    "paths": {
      "@tavus-demo/*": ["./src/*"]
    },
    "strict": true,
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ES2024",
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["dom", "esnext"],
    "noUncheckedIndexedAccess": true
  },
  "exclude": ["node_modules"],
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
